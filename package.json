{
  "name": "bugpattern-gallery",
  "version": "0.1.0",
  "private": true,
  "description": "An executable museum of software failure patterns.",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "test:integration": "node ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "demo": "node ./node_modules/tsx/dist/cli.mjs scripts/demo.ts",
    "package": "node ./node_modules/tsx/dist/cli.mjs scripts/package_release.ts",
    "release-check": "node ./node_modules/tsx/dist/cli.mjs scripts/release_check.ts",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:e2e && npm run build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "15.5.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.2",
    "prettier": "3.9.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
